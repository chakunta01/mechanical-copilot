# Copy to .env on a Linux host running Docker Compose. Replace every placeholder.
PUBLIC_DOMAIN=mechanical.example.com

# Use high-entropy random hex values (at least 32 characters).
SECRET_KEY=replace-with-openssl-rand-hex-32
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-random-secret
POSTGRES_USER=copilot
POSTGRES_PASSWORD=replace-with-random-hex-password
POSTGRES_DB=copilot

# OpenAI-compatible language model and embedding endpoints.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-provider-api-key
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini
# Optional. Leave blank to deploy chat without image generation.
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_GENERATION_MODEL=gpt-image-2.5-flare
EMBEDDINGS_PROVIDER=openai_compatible
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=replace-with-provider-api-key
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536

# The site is served from one origin; keep CORS restricted to that origin.
CORS_ORIGINS=https://mechanical.example.com
RATE_LIMIT_PER_MIN=30

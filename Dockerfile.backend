FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

COPY backend/pyproject.toml ./
RUN pip install --no-cache-dir \
    "fastapi>=0.115,<1" "uvicorn[standard]>=0.30,<1" "pydantic>=2.7,<3" \
    "pydantic-settings>=2.3,<3" "email-validator>=2.1" "sqlalchemy>=2.0,<3" \
    "alembic>=1.13" "httpx>=0.27" "PyYAML>=6.0" "python-multipart>=0.0.9" \
    "Pillow>=10.3" "numpy>=1.26" "opencv-python-headless>=4.9" \
    "passlib[bcrypt]>=1.7.4" "PyJWT>=2.8" "pypdf>=4.2" "python-docx>=1.1" \
    "prometheus-client>=0.20" "psycopg[binary]>=3.1"

COPY backend/app ./app
COPY backend/run.py ./run.py
COPY data ./data

RUN useradd -m appuser && chown -R appuser /srv
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD python -c "import httpx; httpx.get('http://localhost:8000/health', timeout=3)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]

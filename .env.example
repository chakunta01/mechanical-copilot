# =============================================================================
# AI Manufacturing Copilot — environment configuration
# Copy to .env and fill in values. Never commit the real .env.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=dev                        # dev | staging | prod
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database ----------------------------------------------------------------
# Dev default is SQLite (file ./data/copilot.db). Use Postgres in staging/prod:
# DATABASE_URL=postgresql+psycopg://copilot:copilot@db:5432/copilot
DATABASE_URL=sqlite:///./data/copilot.db

# --- Files -------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# --- LLM (OpenAI-compatible gateway: OpenAI, Azure OpenAI, vLLM, Ollama, ...) --
# Works with any endpoint that implements /chat/completions.
LLM_PROVIDER=openai_compatible     # openai_compatible | fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini       # must accept image content parts
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0.2

# --- Embeddings (OpenAI-compatible /v1/embeddings, or offline hashing) --------
EMBEDDINGS_PROVIDER=openai_compatible   # openai_compatible | hashing
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=sk-...
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536

# --- Vector store -------------------------------------------------------------
VECTOR_STORE=numpy                 # numpy (built-in) | chroma (pip install chromadb)
CHROMA_DIR=./data/chroma

# --- Retrieval / grounding ----------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.15
CITATION_REQUIRED=true
UNSUPPORTED_CLAIM_GUARD=true

# --- Vision / inspection ------------------------------------------------------
DEFECT_CONFIDENCE_THRESHOLD=0.60
IMG_MIN_WIDTH=320
IMG_MIN_HEIGHT=240
IMG_MAX_BRIGHTNESS_MEAN=245
IMG_MIN_BRIGHTNESS_MEAN=25
IMG_MAX_BLUR_LAPLACIAN_VAR=35.0
IMG_MAX_GLARE_RATIO=0.25

# --- Security -----------------------------------------------------------------
RATE_LIMIT_PER_MIN=120
